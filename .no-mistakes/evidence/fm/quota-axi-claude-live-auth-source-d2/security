#!/bin/sh
set -eu

printf '%s\n' "$*" >> "$QUOTA_AXI_EVIDENCE_SECURITY_LOG"

account=""
previous=""
for argument in "$@"; do
  if [ "$previous" = "-a" ]; then
    account="$argument"
  fi
  previous="$argument"
done

if [ "$account" = "fixture-user" ]; then
  printf '%s\n' '{"claudeAiOauth":{"accessToken":"synthetic-current-user-token","expiresAt":"2035-01-01T00:00:00.000Z"}}'
  exit 0
fi

if [ -z "$account" ]; then
  printf '%s\n' '{"claudeAiOauth":{"accessToken":"synthetic-stale-duplicate-token","expiresAt":"2035-01-01T00:00:00.000Z"}}'
  exit 0
fi

exit 44
